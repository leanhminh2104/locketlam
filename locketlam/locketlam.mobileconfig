	<key>PayloadScope</key>
	<string>System</string>

	<key>PayloadType</key>
	<string>Configuration</string>

	<key>PayloadUUID</key>
	<string>3C6C2652-9FA8-4D48-9F55-52B19F0D24B1</string>

	<key>PayloadVersion</key>
	<integer>1</integer>

	<key>PayloadOrganization</key>
	<string>LAMDev - dalymmo.com</string>

