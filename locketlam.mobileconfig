<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key>
  <string>Locket Gold 💛 (LAMDev - DaLyMMO)</string>

  <key>PayloadDescription</key>
  <string>Hồ sơ cấu hình NextDNS chuẩn Apple DoH bảo vệ Locket Gold và chống thu hồi chứng chỉ vĩnh viễn.&#10;🌐 Website: dalymmo.com&#10;🛠 Phát hành bởi LAMDev (NextDNS ID: 992769).</string>

  <key>PayloadIdentifier</key>
  <string>com.dalymmo.locketlam.dns.992769.profile</string>

  <key>PayloadScope</key>
  <string>System</string>

  <key>PayloadType</key>
  <string>Configuration</string>

  <key>PayloadUUID</key>
  <string>3C6C2652-9FA8-4D48-9F55-52B19F0D24B1</string>

  <key>PayloadVersion</key>
  <integer>1</integer>

  <key>PayloadOrganization</key>
  <string>LAMDev - dalymmo.com</string>

  <key>PayloadContent</key>
  <array>
    <dict>
      <key>DNSSettings</key>
      <dict>
        <key>DNSProtocol</key>
        <string>HTTPS</string>

        <!-- Điểm cuối DoH chính thức gắn kèm tên thiết bị locketlam để ghi nhận Analytics trên NextDNS -->
        <key>ServerURL</key>
        <string>https://apple.dns.nextdns.io/992769/locketlam</string>

        <!-- Địa chỉ IP mồi chuẩn NextDNS Anycast (IPv4 và IPv6) -->
        <key>ServerAddresses</key>
        <array>
          <string>45.90.28.15</string>
          <string>45.90.30.15</string>
          <string>2a07:a8c0::99:2769</string>
          <string>2a07:a8c1::99:2769</string>
        </array>
      </dict>

      <key>OnDemandRules</key>
      <array>
        <!-- Bỏ qua Captive Portal để không bị kẹt khi đăng nhập Wi-Fi công cộng hoặc xác thực mạng di động -->
        <dict>
          <key>Action</key>
          <string>EvaluateConnection</string>
          <key>ActionParameters</key>
          <array>
            <dict>
              <key>DomainAction</key>
              <string>NeverConnect</string>
              <key>Domains</key>
              <array>
                <string>captive.apple.com</string>
                <string>3gppnetwork.org</string>
                <string>dav.orange.fr</string>
                <string>vvm.mobistar.be</string>
                <string>vvm.mstore.msg.t-mobile.com</string>
                <string>tma.vvm.mone.pan-net.eu</string>
                <string>vvm.ee.co.uk</string>
              </array>
            </dict>
          </array>
        </dict>

        <!-- Tự động kích hoạt trên mọi mạng (Wi-Fi, 4G, 5G, Hotspot) -->
        <dict>
          <key>Action</key>
          <string>Connect</string>
        </dict>
      </array>

      <key>PayloadType</key>
      <string>com.apple.dnsSettings.managed</string>

      <key>PayloadIdentifier</key>
      <string>com.dalymmo.locketlam.dns.992769.managed</string>

      <key>PayloadUUID</key>
      <string>62F0D8E9-2182-4E38-9844-3B9B3BC03417</string>

      <key>PayloadDisplayName</key>
      <string>NextDNS (992769 / locketlam)</string>

      <key>PayloadDescription</key>
      <string>Cấu hình DNS-over-HTTPS (DoH) bảo mật bảo vệ thiết bị và Locket Gold.</string>

      <key>PayloadOrganization</key>
      <string>LAMDev - dalymmo.com</string>

      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>

  <key>PayloadRemovalDisallowed</key>
  <false/>
</dict>
</plist>
