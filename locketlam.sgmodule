#!name=Locket Gold VIP - LAMDev
#!desc=Mở khóa Locket Gold VIP vĩnh viễn (RevenueCat + Firebase Remote Config). Phát hành bởi LAMDev (dalymmo.com).
#!author=LAMDev
#!homepage=https://dalymmo.com
#!tgchannel=https://t.me/dalymmo
#!moduleUrl=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam.sgmodule
#!icon=https://raw.githubusercontent.com/leanhminh2104/shadowrocket/refs/heads/locketlam/assets/img/shadowrocket.webp
#!howtouse=Shadowrocket

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
# Mở khóa gói Locket Gold qua RevenueCat
Locket_RevenueCat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag header để luôn nhận phản hồi mới
Locket_DeleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/deleteHeader.js, timeout=60

# Mở khóa toàn bộ Remote Config (huy hiệu, khung widget, icon, video dài, xem locket)
Locket_RemoteConfig = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locket_remote.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
